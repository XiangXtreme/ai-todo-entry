<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ms_widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="28dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✓"
            android:textColor="#00A5E0"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="任务⌄"
            android:textColor="#20242C"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/widget_refresh"
            style="@style/MsWidgetHeaderButton"
            android:text="⟳" />

        <TextView
            android:id="@+id/widget_add_button"
            style="@style/MsWidgetHeaderButton"
            android:contentDescription="AI 添加任务"
            android:text="+" />

        <TextView
            android:id="@+id/widget_settings"
            style="@style/MsWidgetHeaderButton"
            android:text="⚙" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="18dp"
        android:textColor="#5E6472"
        android:textSize="15sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_task_row_1"
        style="@style/MsWidgetTaskRow">
        <TextView
            android:id="@+id/widget_task_check_1"
            style="@style/MsWidgetTaskCheck" />
        <LinearLayout style="@style/MsWidgetTaskTextContainer">
            <TextView
                android:id="@+id/widget_task_title_1"
                style="@style/MsWidgetTaskTitle" />
            <TextView
                android:id="@+id/widget_task_due_1"
                style="@style/MsWidgetTaskDue" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_task_star_1"
            style="@style/MsWidgetTaskStar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_2"
        style="@style/MsWidgetTaskRow">
        <TextView
            android:id="@+id/widget_task_check_2"
            style="@style/MsWidgetTaskCheck" />
        <LinearLayout style="@style/MsWidgetTaskTextContainer">
            <TextView
                android:id="@+id/widget_task_title_2"
                style="@style/MsWidgetTaskTitle" />
            <TextView
                android:id="@+id/widget_task_due_2"
                style="@style/MsWidgetTaskDue" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_task_star_2"
            style="@style/MsWidgetTaskStar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_3"
        style="@style/MsWidgetTaskRow">
        <TextView
            android:id="@+id/widget_task_check_3"
            style="@style/MsWidgetTaskCheck" />
        <LinearLayout style="@style/MsWidgetTaskTextContainer">
            <TextView
                android:id="@+id/widget_task_title_3"
                style="@style/MsWidgetTaskTitle" />
            <TextView
                android:id="@+id/widget_task_due_3"
                style="@style/MsWidgetTaskDue" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_task_star_3"
            style="@style/MsWidgetTaskStar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_task_row_4"
        style="@style/MsWidgetTaskRow">
        <TextView
            android:id="@+id/widget_task_check_4"
            style="@style/MsWidgetTaskCheck" />
        <LinearLayout style="@style/MsWidgetTaskTextContainer">
            <TextView
                android:id="@+id/widget_task_title_4"
                style="@style/MsWidgetTaskTitle" />
            <TextView
                android:id="@+id/widget_task_due_4"
                style="@style/MsWidgetTaskDue" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_task_star_4"
            style="@style/MsWidgetTaskStar" />
    </LinearLayout>
</LinearLayout>
